# Optional overrides: make dev works without this file.
# Public local-only examples, NOT secrets. Never expose this unauthenticated stack.
# Changing POSTGRES_* requires a matching URL-encoded DATABASE_URL and a fresh volume.
POSTGRES_DB=taskmarshal
POSTGRES_USER=taskmarshal
POSTGRES_PASSWORD=taskmarshal-local-only
DATABASE_URL=postgresql+psycopg://taskmarshal:taskmarshal-local-only@db:5432/taskmarshal
TEMPORAL_ADDRESS=temporal:7233
VITE_API_URL=http://localhost:8000
LOG_LEVEL=INFO
